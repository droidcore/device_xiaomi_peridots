android_app {
    name: "XiaomiParts",
    defaults: [
        "SettingsLibDefaults",
    ],

    srcs: [
        "src/**/*.kt",
        "src/**/*.java"
    ],
    certificate: "platform",
    resource_dirs: ["res"],
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "androidx.core_core",
        "org.lineageos.settings.resources",
        "SettingsLib",
    ],
}